{
  "name": "decentralized-voting",
  "version": "1.0.0",
  "description": "Decentralized Voting System using Ethereum Blockchain",
  "main": "index.js",
  "scripts": {
    "hardhat-node": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true npx hardhat node",
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true npx hardhat compile",
    "deploy": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true npx hardhat run scripts/deploy.js --network localhost",
    "server": "node index.js",
    "chain:prepare": "npm run compile && npm run deploy",
    "build": "npm run compile && npm run client:build",
    "start": "npm run start:all",
    "start:all": "bash start.sh",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@truffle/contract": "^4.6.18",
    "browserify": "^17.0.0",
    "cheerio": "^1.0.0-rc.12",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "web3": "^1.9.0"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "ethers": "^5.7.2",
    "hardhat": "^2.22.0"
  }
}
